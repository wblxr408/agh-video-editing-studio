            }
          }
        }
      }
    ],
    "clientDescriptors": [
      {
        "rowId": "ext:wblxr408/video-editing-studio-runtime",
        "path": "./client/agnes.client.json"
      }
    ],
    "application": {
      "id": "video-editing-studio",
      "presentation": {
        "navigation": {
          "entries": ["@wblxr408/video-editing-studio-runtime#video-editing-studio"]
        }
      }
